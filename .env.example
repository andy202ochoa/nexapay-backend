# Servidor Express (solo en local; en Vercel no se usa)
PORT=3000

# Base de datos PostgreSQL (por ejemplo, Neon).
# Para el backend en Vercel usa la cadena "pooled" de Neon (host con "-pooler").
# Para correr las migraciones (npm run migrate:up) puedes usar la cadena directa.
DATABASE_URL=

# Autenticación JWT (cadena larga y aleatoria)
JWT_SECRET=

# URL del frontend permitida por CORS (en producción, el dominio de Vercel del frontend)
FRONTEND_URL=http://localhost:5173

# Inicio de sesión con Google (OAuth 2.0)
# ID de cliente de Google Cloud Console; el frontend debe usar el mismo.
# Sin esta variable, POST /api/auth/google responde 500.
GOOGLE_CLIENT_ID=

# Asistente NEXAPAY AI (Google Gemini). La clave se crea en Google AI Studio y nunca se sube al repositorio.
GEMINI_API_KEY=
# Modelo de Gemini (opcional)
AI_MODEL=gemini-3.5-flash-lite

# Correo de bienvenida con AWS SES (opcional: si falta, el registro funciona igual)
# Se llaman SES_* porque Vercel reserva los nombres AWS_*.
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=
SES_REGION=us-east-1
SES_FROM_EMAIL=
